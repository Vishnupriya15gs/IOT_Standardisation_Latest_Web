﻿@{
    ViewBag.Title = "Production";
}

@Styles.Render("~/assets/css")
<link rel="stylesheet" href="~/StyleSheets/Line Overview/Production/Layout.css" />

<!--charts-->
<link rel="stylesheet" href="~/StyleSheets/Charts/tooltipBars.css" />
<link rel="stylesheet" href="~/StyleSheets/Charts/svg.css" />
<link rel="stylesheet" href="~/StyleSheets/Charts/bargraphBars.css" />
<link rel="stylesheet" href="~/StyleSheets/Charts/linegraphLines.css" />
