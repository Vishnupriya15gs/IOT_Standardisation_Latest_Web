<script>


    function color(myHash, slope, cnst, frequency) {

        const i = ((frequency * slope) + cnst);
        var per = Math.abs(i);
        const opacity = per;
        per = per * 10;
        if (!myHash[per]) {
            myHash[per] = 'rgb(0,0,255,' + opacity + ')';

        }
        console.log(myHash[per]);
        return myHash[per];
    }




    function graph(id, response) {
        // const queue = [ "#005100", "#008200", "#00b300", "#00e400", "#16ff16", "#47ff47", "#78ff78", "#a9ffa9","#dafeda","#cee2da"];
        var myHash = {};
        sample_pareto = response.data.Table;
        for (var i = 0; i < response.data.Table.length; i++) {
            x = response.data.Table[i].total;
            $('totalcount').text(x);
        }

        if (sample_pareto.length == 1) {
            $(id).css("width", "20%");

        }
        else
            if (sample_pareto.length <= 2) {
                $(id).css("width", "30%");

            }

            else if (sample_pareto.length < 5) {
                $(id).css("width", "50%");

            }
            else if (sample_pareto.length > 5 && sample_pareto.length < 10) {
                $(id).css("width", "80%");
            }
            else {
                $(id).css("width", "100%");
            }

        const a = $(id).height();
        const b = $(id).width();



        var m = { top: 25, right: 50, bottom: 150, left: 50 }
            , h = a - m.top - m.bottom - 25
            , w = b - m.left - m.right
            , barWidth = 5;

        var dataset = null;
        //typecast Amount to #, calculate total, and cumulative amounts
        const max = d3.max(sample_pareto, function (d) { return d.Frequency; });
        const min = d3.min(sample_pareto, function (d) { return d.Frequency; });


        const max2 = d3.max(sample_pareto, d => d.Frequency);
        const thresholdValue = 0.8 * max2; // 80% of max frequency

        //const thresholdValue = 0.8 * max; // 80% of max frequency
        //y=mx+c

        const slope = (0.7 / (max - min));
        const cnst = (0.3 - (min * slope));
        // console.log("max:"+max+" min:"+min+" slope:" + slope + "cnst:" + cnst);
        //const slope = ((max - min) );
        //const cnst = (150 - (min * slope));


        //Axes and scales
        var xScale = d3.scaleBand().rangeRound([0, w], 0.1);
        xScale.domain(sample_pareto.map(function (d) { return d.RejectionDescription; }));
        xScale.paddingInner(0.2)
        xScale.paddingOuter(0.2);

        var yhist = d3.scaleLinear()
            .domain([0, d3.max(sample_pareto, function (d) { return d.Frequency; })])
            .range([h, 0]);

        var ycum = d3.scaleLinear().domain([0, 100]).range([h, 0]);

        var xAxis = d3.axisBottom()
            .scale(xScale);


        var yAxis = d3.axisLeft()
            .scale(yhist)


        var yAxis2 = d3.axisRight()
            .scale(ycum);

        d3.selectAll(id + " > *").remove();

        var tooltip = d3.select(".custom")
            .append("div")
            .style("opacity", 0)
            .attr("class", "tooltip")
            .style("background-color", "tranparent")
            .style("border", "solid")
            .style("border-width", "2px")
            .style("border-radius", "5px")
            .style("padding", "5px")



        tooltip = d3.select("body").append("div").style("width", "200px").style("height", "150px").style("background", "white")
            .style("opacity", "1").style("position", "absolute").style("visibility", "hidden").style("padding", "5px");
        toolval = tooltip.append("div");

        ////Draw svg
        var svg_pareto = d3.select(id).append("svg")
            .attr("width", w + m.left + m.right)
            .attr("height", h + m.top + m.bottom)
            .append("g")
            .attr("transform", "translate(" + m.left + "," + m.top + ")");




        //var color = d3.scaleOrdinal(d3.schemeCategory10);

        //Draw histogram
        var bar_pareto = svg_pareto.selectAll(".bar")
            .data(sample_pareto)
            .enter().append("g")
            .attr("class", "bar")




        var check = bar_pareto.append("rect")
            .attr("x", function (d) { return xScale(d.RejectionDescription) + 10; })
            .attr("width", Math.min(xScale.bandwidth() - 2, 70))
            .attr("y", function (d) { return yhist(d.Frequency); })
            .attr("height", function (d) { return h - yhist(d.Frequency); })
            .style("fill", function (d) {
                return color(myHash, slope, cnst, d.Frequency);
            })
            .attr("text", function (d) { return `${d.Frequency}` })



            .on("mouseout", function () {
                d3.select(this).style('Stroke', 'none');
                d3.selectAll(".bar").transition()
                    .style("opacity", 1);
                tooltip.style("visibility", "hidden");
            })

            .on("mousemove", function (d) {
                var bar = d3.select(this);
                var label = d3.select(this.parentNode).selectAll('.label').data([d]);
                d3.selectAll(".bar").transition()
                    .style("opacity", 4);
                d3.select(this).style('Stroke', 'white');
                d3.select(this).style('stroke-width', '2');
                d3.select(this).transition()
                    .style("opacity", 2);
                tooltip.style("visibility", "visible")
                    .style("top", (d3.event.pageY - 30) + "px").style("left", (d3.event.pageX + 20) + "px");

                var text = 'Occurence: ' + d.Frequency + ' (times)<br/> Percentage: ' + d.Percentage + '<br/> Weightage: ' + d.Weightage + '' + "%" + ' <br/> RejectionDescription: ' + d.RejectionDescription + '';


                tooltip.select("div").html(text)


            })



        if (id == ".heatmap_custom")
            check.on("click", function (d) {
                get_Rejection_data(d.RejectionDescription);

            })
        else
            if (id == ".year_report")
                check.on("click", function (d) {
                    get_Rejection_data_yearwise(d.RejectionDescription);

                })
            else
                if (id == ".monthly_chart")
                    check.on("click", function (d) {
                        get_Rejection_data_monthwise(d.RejectionDescription);

                    })


        bar_pareto.selectAll(".bar-title")
            .data(sample_pareto)
            .enter()
            .append("text")
            .classed('bar-title', true)
            .attr('text-anchor', 'middle')
            .attr("x", d => xScale(d.RejectionDescription) + xScale.bandwidth() / 2)
            .attr("y", function (d) { return yhist(d.Frequency); })
            .style('fill', '#000000')
            .text((a) => `${a.Frequency}`)


        ////Draw CDF line

        var guide = d3.line()
            .x(function (d) { return xScale(d.RejectionDescription) + (xScale.bandwidth() / 2); })
            .y(function (d) { return ycum(d.Percentage) });


        var line = svg_pareto.append('path')
            .datum(sample_pareto)
            .attr('d', guide)
            .attr('class', 'line');

        var selectCircle = svg_pareto.selectAll(".circle")
            .data(sample_pareto)
        selectCircle
            .enter().append("circle")
            .attr("r", 3.5)
            .attr("cx", function (d) { return xScale(d.RejectionDescription) + (xScale.bandwidth() / 2); })
            .attr("cy", function (d) { return ycum(d.Percentage) });

        // Draw vertical line at 80% mark
        const yThreshold = yhist(thresholdValue); // Y position for the 80% threshold
        const barAtThreshold = sample_pareto.find(d => d.Frequency >= thresholdValue);
        if (barAtThreshold) {
            const barX = xScale(barAtThreshold.RejectionDescription) + xScale.bandwidth() / 2; // Center of the bar
            //svg_pareto.append("line")
            //    .attr("class", "marker")
            //    .attr("x1", barX) // X position for the center of the bar
            //    .attr("y1", yThreshold) // Y position for the 80% threshold
            //    .attr("x2", barX) // Same X position
            //    .attr("y2", h) // Extend to the bottom of the chart
            //    .attr("stroke", "red")
            //    .attr("stroke-width", 2);

            // Add label for the marker
            //svg_pareto.append("text")
            //    .attr("class", "marker-label")
            //    .attr("x", barX + 5) // Position next to the line
            //    .attr("y", yThreshold - 5) // Position just above the line
            //    .text("80%")
            //    .style("text-anchor", "start")
            //    .style("fill", "red");
        }


        //Draw axes
        //svg_pareto.append("g")
        //    .attr("class", "x axis")
        //    .attr("transform", "translate(0," + h + ")")
        //    .call(xAxis)
        //    .selectAll("text")
        //    .style("text-anchor", "end")
        //    .attr("transform", "rotate(-65)");

        //tooltip on x axis label 
        svg_pareto.append('g')
            .attr("class", "x axis")
            .attr("transform", "translate(0," + h + ")")
            .call(xAxis)
            .selectAll("text")
            .style("text-anchor", "end")
            .attr("transform", "rotate(-65)")
            .append("title")  // This line adds tooltip functionality
            .text(function (d) { return d; });


        svg_pareto.append("g")
            .attr("class", "y axis")
            .call(yAxis)
            .append("text")
            .attr("transform", "rotate(-90)")
            .attr("y", -50)
            .attr("dy", ".71em")
            .style("text-anchor", "end")

            .text("Occurrence (times)");

        svg_pareto.append("g")
