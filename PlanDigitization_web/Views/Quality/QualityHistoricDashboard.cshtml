            .attr("y", -50)
            .attr("dy", ".75em")
            .attr('text-anchor', 'end')

            .attr("transform", "rotate(-90)")
            .text("Occurrence (times)");

        svg_pareto.append("text")
            .attr("class", "y label2")
            //.attr("text-anchor", "end")
            //.attr("y", -50)
            .attr("dy", ".75em")
            .attr('text-anchor', 'end')

            .attr("transform", "translate(" + [w, 0] + ")")
